# Terminus front-end environment (Vite).
# These are PUBLIC, browser-safe values — the publishable key is designed to be
# shipped in the client bundle. Do NOT put the service_role / secret key here.
#
# For Cloudflare Pages, set these in the Pages project's Build & Deploy
# environment variables (Production and Preview) instead of committing a .env.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
